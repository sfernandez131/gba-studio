          },
          {
            "id": "15f00000-0000-4000-8000-000000000030",
            "command": "EVENT_GBA_CUSTOM_CODE",
            "args": {
              "code": "// M15f ending flourish - author C++ compiled straight into the ROM.\n// Butano (bn::*) and the engine bridge (hw_*) are both in scope here.\nint a = 1, b = 1;\nfor(int i = 0; i < 10; ++i) { const int t = a + b; a = b; b = t; }\nconst bn::fixed resonance = bn::fixed(b) * 2;   // 144 * 2\nGBA_VAR(60) = resonance.integer();              // 288, a scratch VM slot\nhw_camera_shake(24);                            // the Gem flares"
            }
          },
          {
            "id": "15f00000-0000-4000-8000-000000000031",
            "command": "EVENT_TEXT",
            "args": {
              "text": "The whole village\nturns out to cheer.",
              "avatarId": "face00000-0000-4000-8000-0000000000a1"
            }
          },
